{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build BasicDynamicEntity",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "BasicDynamicEntity.sln",
        "--ignore-failed-sources"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run BasicDynamicEntity",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "BasicDynamicEntity.csproj"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Run BasicDynamicEntity (No Build)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "BasicDynamicEntity.csproj",
        "--no-build"
      ],
      "isBackground": false,
      "problemMatcher": []
    }
  ]
}
