<Window x:Class="CommandDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:CommandDashboard.Models"
        xmlns:calcite="http://schemas.esri.com/calcite/2024"
        xmlns:esri="http://schemas.esri.com/arcgis/runtime/2013"
        mc:Ignorable="d"
        Style="{StaticResource CalciteWindowStyle}"
        Title="Command Dashboard"
        Height="720"
        Width="1180"
        MinHeight="560"
        MinWidth="920">
    <Window.Resources>
        <Style x:Key="VipStatusBannerStyle"
               TargetType="Border"
               BasedOn="{StaticResource CalciteFormBorderStyle}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource CalciteStatusSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnyVipDanger}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CalciteStatusWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAnyVipOut}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CalciteStatusDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VipStopActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CalciteDangerButtonStyle}">
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VipHurryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CalcitePrimaryButtonStyle}">
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VipSearchToggleButtonStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource CalciteSecondaryButtonBaseStyle}">
            <Setter Property="Foreground" Value="{StaticResource CalciteText1Brush}" />
            <Setter Property="ToolTip" Value="Show VIP filter" />
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CalciteBrandPressBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CalciteBrandPressBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CalciteTextInverseBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource CalciteBrandBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CalciteBrandHoverBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CalciteTextInverseBrush}" />
                    <Setter Property="ToolTip" Value="Hide VIP filter" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource CalciteBrandPressBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CalciteBrandPressBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CalciteTextInverseBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CalciteBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="14,14,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CalciteText1Brush}"
                           Text="Command Dashboard" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="{StaticResource CalciteText2Brush}"
                           Text="{Binding SessionId, StringFormat=Session: {0}}" />
            </StackPanel>

            <Border Grid.Column="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Style="{StaticResource VipStatusBannerStyle}">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource CalciteTextInverseBrush}"
                           Text="{Binding VipOverallStatus}" />
            </Border>

        </Grid>

        <Grid Grid.Row="2" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="10"
                    BorderBrush="{StaticResource CalciteBorder1Brush}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <esri:MapView x:Name="MainMapView" Map="{Binding MainMap}" />
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="10"
                    BorderBrush="{StaticResource CalciteBorder1Brush}"
                    BorderThickness="1"
                    Background="{StaticResource CalciteBackground1Brush}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                            Padding="12"
                            CornerRadius="8"
                            Background="{StaticResource CalciteBackground2Brush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CalciteText1Brush}"
                                       Text="Operations Summary" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource CalciteText3Brush}"
                                               FontSize="12"
                                               Text="Escort" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{StaticResource CalciteText1Brush}"
                                               FontWeight="SemiBold"
                                               Text="{Binding EscortConnectionState}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource CalciteText3Brush}"
                                               FontSize="12"
                                               Text="VIPs Tracked" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{StaticResource CalciteText1Brush}"
                                               FontWeight="SemiBold"
                                               Text="{Binding TotalVIPs}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="4"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource CalciteText1Brush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding VipPerimeterSummary}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CalciteText1Brush}"
                                       Text="VIPs" />

                            <ToggleButton x:Name="VipSearchToggle"
                                          Grid.Column="1"
                                          Width="32"
                                          Height="32"
                                          Padding="0"
                                          Style="{StaticResource VipSearchToggleButtonStyle}">
                                <TextBlock Text="{calcite:CalciteIconGlyph Icon=Search}"
                                           FontFamily="{StaticResource CalciteUIIconsMediumFontFamily}"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </ToggleButton>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding VipWhereClause, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     Padding="8,4"
                                     MinHeight="30" />

                            <Button Grid.Column="2"
                                    Content="Apply"
                                    Command="{Binding ApplyVipFilterCommand}"
                                    Style="{StaticResource CalcitePrimaryButtonStyle}" />

                            <Button Grid.Column="4"
                                    Content="Clear"
                                    Command="{Binding ClearVipFilterCommand}"
                                    Style="{StaticResource CalciteSecondaryButtonStyle}" />
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=VipSearchToggle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <TextBlock Grid.Row="4"
                                   Foreground="{StaticResource CalciteText3Brush}"
                                   FontSize="12"
                                   Text="{Binding VipFilterStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=VipSearchToggle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer Grid.Row="6"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent"
                                      CanContentScroll="True">
                            <ItemsControl ItemsSource="{Binding FilteredVipUnits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FieldUnitStatus}">
                                            <Border Margin="0,0,0,8"
                                                Padding="12"
                                                MinHeight="74"
                                                CornerRadius="8"
                                                Background="{StaticResource CalciteBackground2Brush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource CalciteBackground2Brush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource CalciteBorder2Brush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:UnitStatus.In}">
                                                            <Setter Property="Background" Value="{StaticResource CalciteStatusSuccessBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CalciteStatusSuccessHoverBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:UnitStatus.Warning}">
                                                            <Setter Property="Background" Value="{StaticResource CalciteStatusWarningBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CalciteStatusWarningHoverBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CalciteStatusDangerBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource CalciteStatusDangerHoverBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="4" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Foreground="{StaticResource CalciteText1Brush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Text="{Binding DisplayName}" />

                                                <Border Grid.Column="1"
                                                        Padding="10,3"
                                                        CornerRadius="10"
                                                        Background="{StaticResource CalciteBackground3Brush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource CalciteBackground3Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:UnitStatus.In}">
                                                                    <Setter Property="Background" Value="{StaticResource CalciteStatusSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:UnitStatus.Warning}">
                                                                    <Setter Property="Background" Value="{StaticResource CalciteStatusWarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource CalciteStatusDangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Foreground="{StaticResource CalciteText1Brush}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding StatusDisplayText}" />
                                                </Border>

                                                <Grid Grid.Row="2"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Foreground="{StaticResource CalciteText1Brush}"
                                                               Text="{Binding DistanceMeters, StringFormat=Distance: {0:0.0} m}" />
                                                    <TextBlock Grid.Column="1"
                                                               Foreground="{StaticResource CalciteText1Brush}"
                                                               HorizontalAlignment="Right"
                                                               Text="{Binding DirectionToEscort, StringFormat=Direction: {0}}" />
                                                </Grid>

                                                <Grid Grid.Row="4"
                                                                                                            Grid.ColumnSpan="2">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                                <ColumnDefinition Width="*" />
                                                                                                                <ColumnDefinition Width="8" />
                                                                                                                <ColumnDefinition Width="*" />
                                                                                                        </Grid.ColumnDefinitions>
                                                    <Button Content="Stop"
                                                            Click="OnVipStopClick"
                                                            Tag="{Binding DisplayName}"
                                                            Style="{StaticResource VipStopActionButtonStyle}" />
                                                    <Button Grid.Column="2"
                                                            Content="Hurry"
                                                            Click="OnVipHurryClick"
                                                            Tag="{Binding DisplayName}"
                                                            Style="{StaticResource VipHurryActionButtonStyle}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
